generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

model Subject {
  id          String   @id @default(cuid())
  name        String
  level       String?  // Contoh: "Kelas 5", "Semester 3"
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  classes     Class[]
}

model Class {
  id          String    @id @default(cuid())
  name        String    // Contoh: "PAI 5A", "TBI 5", "PAI 5B"
  level       String?   // Contoh: "Semester 5", "Pai 5 a dan TBI 5"
  description String?
  subjectId   String?   // Opsional untuk kompatibilitas data lama
  subject     Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  students    Student[]
  exams       Exam[]

  @@index([name])
}

model Student {
  id              String   @id @default(cuid())
  nim             String
  name            String
  classId         String
  class           Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  isAllowed       Boolean  @default(true) // Izin mengikuti ujian (false jika kehadiran kurang / dicekal)
  allowExamReason String?  // Alasan pencekalan (contoh: "Kehadiran < 75%")
  createdAt       DateTime @default(now())

  @@unique([classId, nim])
  @@index([nim])
}

model Exam {
  id              String        @id @default(cuid())
  title           String        // Contoh: "UTS", "Tugas 1", "Tugas Mandiri 2"
  subjectName     String?       // Contoh: "Manajemen Lembaga Pendidikan Islam (MLPI)"
  classId         String
  class           Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  durationMinutes Int           @default(90)
  minWords        Int           @default(0)
  isActive        Boolean       @default(false)
  startTime       DateTime?     // Tanggal & Jam Mulai Ujian (Jadwal Otomatis)
  endTime         DateTime?     // Tanggal & Jam Selesai Ujian (Jadwal Otomatis)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  questions       Question[]
  sessions        ExamSession[]

  @@index([classId])
  @@index([isActive])
}

model Question {
  id              String   @id @default(cuid())
  examId          String
  exam            Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  text            String
  order           Int
  points          Int      @default(10)
  allowFileUpload Boolean  @default(false) // Sakelar upload file/diagram/gambar
  fileRequired    Boolean  @default(false) // Wajib upload jika true
  answers         Answer[]

  @@index([examId, order])
}

model ExamSession {
  id          String    @id @default(cuid())
  examId      String
  exam        Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentName String
  studentNim  String
  ipAddress   String?
  userAgent   String?
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  answers     Answer[]

  @@index([studentNim])
  @@index([examId, studentNim])
  @@index([submittedAt])
}

model Answer {
  id         String      @id @default(cuid())
  sessionId  String
  session    ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId String
  question   Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer     String      @default("")
  wordCount  Int         @default(0)
  fileUrl    String?     // URL file jika dosen menyalakan switch upload
  fileName   String?     // Nama file asli
  answeredAt DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([sessionId, questionId])
}

model LandingSetting {
  id                String   @id @default("default")
  institutionName   String   @default("IAI TABAH LAMONGAN")
  facultyName       String   @default("Fakultas Tarbiyah dan Ilmu Keguruan (FTIK)")
  universityName    String   @default("Fakultas Tarbiyah dan Ilmu Keguruan (FTIK)")
  portalTitle       String   @default("Portal Ujian & Penugasan Digital")
  portalSubtitle    String   @default("Platform Evaluasi Akademik Mahasiswa Terintegrasi")
  heroHeadline      String   @default("Portal Ujian & Penugasan Digital")
  ctaButtonText     String   @default("Mulai Masuk & Kerjakan Soal")
  ctaHelperText     String   @default("Cukup siapkan NIM Anda yang telah didaftarkan di kelas")
  academicYear      String   @default("Tahun Akademik 2026/2027")
  logoUrl           String?
  heroImageUrl      String?
  announcementTitle String   @default("Petunjuk & Tata Tertib Pelaksanaan Ujian")
  announcementBody  String   @default("1. Pastikan koneksi internet stabil selama pengerjaan.\n2. Masukkan NIM yang valid untuk memuat identitas dan kelas secara otomatis.\n3. Dilarang melakukan kecurangan (sistem dilengkapi proteksi anti-contek dan anti-inspect).\n4. Jika batas waktu habis, lembar jawaban akan otomatis dikumpulkan ke sistem.")
  bannerImageUrl    String?
  feature1Title     String   @default("Uraian Essay & Lampiran Digital")
  feature1Desc      String   @default("Tuliskan analisis dan uraian essay secara terstruktur. Lengkapi jawaban dengan unggahan diagram teknis, sketsa kurikulum, atau foto lembar kerja yang otomatis tercetak rapi ke berkas PDF.")
  feature2Title     String   @default("Timer Realtime & Auto-Save Cloud")
  feature2Desc      String   @default("Seluruh ketikan jawaban tersimpan otomatis secara berkala ke cloud. Tidak perlu khawatir apabila koneksi terputus sesaat atau terjadi gangguan perangkat, pengerjaan dapat langsung dilanjutkan.")
  feature3Title     String   @default("Unduh Lembar Jawaban PDF Resmi")
  feature3Desc      String   @default("Begitu ujian selesai dikumpulkan, mahasiswa dan dosen pengampu dapat langsung mengunduh salinan lembar jawaban berformat PDF resmi terverifikasi lengkap dengan waktu submit dan nama mahasiswa.")
  footerText        String   @default("Hak Cipta Dilindungi.")
  updatedAt         DateTime @updatedAt
}
